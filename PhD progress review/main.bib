@article{Brihaye:2021,
  title    = {On relevant equilibria in reachability games},
  journal  = {Journal of Computer and System Sciences},
  volume   = {119},
  pages    = {211-230},
  year     = {2021},
  issn     = {0022-0000},
  doi      = {https://doi.org/10.1016/j.jcss.2021.02.009},
  url      = {https://www.sciencedirect.com/science/article/pii/S0022000021000246},
  author   = {Thomas Brihaye and Véronique Bruyère and Aline Goeminne and Nathan Thomasset},
  keywords = {Multiplayer non-zero-sum games played on graphs, Reachability objectives, Relevant equilibria, Social welfare, Pareto optimality},
  abstract = {We study multiplayer reachability games played on a finite directed graph equipped with target sets, one for each player. In those reachability games, it is known that there always exists a Nash equilibrium. But sometimes several equilibria may coexist. For instance we can have two equilibria: a first one where no player reaches his target set and an other one where all the players reach their target set. It is thus very natural to identify “relevant” equilibria. In this paper, we consider different notions of relevant Nash equilibria including Pareto optimal equilibria and equilibria with high social welfare. We also study relevant subgame perfect equilibria in reachability games. We provide complexity results for various related decision problems for both Nash equilibria and subgame perfect equilibria.}
}

