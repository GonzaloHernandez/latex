@article{BRIHAYE2021211,
  title    = {On relevant equilibria in reachability games},
  journal  = {Journal of Computer and System Sciences},
  volume   = {119},
  pages    = {211-230},
  year     = {2021},
  issn     = {0022-0000},
  doi      = {https://doi.org/10.1016/j.jcss.2021.02.009},
  url      = {https://www.sciencedirect.com/science/article/pii/S0022000021000246},
  author   = {Thomas Brihaye and Véronique Bruyère and Aline Goeminne and Nathan Thomasset},
  keywords = {Multiplayer non-zero-sum games played on graphs, Reachability objectives, Relevant equilibria, Social welfare, Pareto optimality},
  abstract = {We study multiplayer reachability games played on a finite directed graph equipped with target sets, one for each player. In those reachability games, it is known that there always exists a Nash equilibrium. But sometimes several equilibria may coexist. For instance we can have two equilibria: a first one where no player reaches his target set and an other one where all the players reach their target set. It is thus very natural to identify “relevant” equilibria. In this paper, we consider different notions of relevant Nash equilibria including Pareto optimal equilibria and equilibria with high social welfare. We also study relevant subgame perfect equilibria in reachability games. We provide complexity results for various related decision problems for both Nash equilibria and subgame perfect equilibria.}
}

@article{BruyereVeronique2021Oteo,
  abstract  = {We study multi-player turn-based games played on (potentially infinite) directed graphs. An outcome is assigned to every play of the game. Each player has a preference relation on the set of outcomes which allows him to compare plays. We focus on the recently introduced notion of weak subgame perfect equilibrium (weak SPE). This is a variant of the classical notion of SPE, where players who deviate can only use strategies deviating from their initial strategy in a finite number of histories. Having an SPE in a game implies having a weak SPE but the contrary is generally false.
               We propose general conditions on the structure of the game graph and on the preference relations of the players that guarantee the existence of a weak SPE, that additionally is finite-memory. From this general result, we derive two large classes of games for which there always exists a weak SPE: (i) the games with a finite-range outcome function, and (ii) the games with a finite underlying graph and a prefix-independent outcome function. For the second class, we identify conditions on the preference relations that guarantee memoryless strategies for the weak SPE.},
  author    = {Bruyère, Véronique and Le Roux, Stéphane and Pauly, Arno and Raskin, Jean-François},
  address   = {SAN DIEGO},
  copyright = {2020 Elsevier Inc.},
  issn      = {0890-5401},
  journal   = {Information and computation},
  keywords  = {Computer Science ; Computer Science, Theory & Methods ; Mathematics ; Mathematics, Applied ; Multi-player non zero-sum graph game ; Physical Sciences ; Science & Technology ; Subgame perfect equilibrium ; Synthesis of equilibrium ; Technology},
  language  = {eng},
  pages     = {104553-},
  publisher = {Elsevier Inc},
  title     = {On the existence of weak subgame perfect equilibria},
  volume    = {276},
  year      = {2021}
}

